# =============================================================================
# Pilot Prospector - environment variables
#
# Copy this file to ".env" and fill in the real values.
# ".env" is git-ignored and must NEVER be committed or shared publicly.
# =============================================================================

# -----------------------------------------------------------------------------
# SAFE FOR THE BROWSER
# Anything starting with VITE_ is bundled into the JavaScript that users
# download. Treat these as public. They are safe ONLY because Row Level
# Security in the database decides what each person may actually see.
# -----------------------------------------------------------------------------

# Supabase -> Project Settings -> Data API -> Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase -> Project Settings -> API Keys -> anon / public
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Shown in the browser tab and on the login screen.
VITE_APP_NAME=Pilot Prospector


# =============================================================================
# SERVER ONLY - NEVER prefix these with VITE_
# These live only in Netlify's environment settings and are used inside
# netlify/functions. If any of these ever reached the browser, someone could
# read and change every record in the database.
# =============================================================================

# Supabase -> Project Settings -> API Keys -> service_role (click "Reveal")
# This key bypasses ALL security rules. Guard it like a password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase -> Project Settings -> API Keys -> JWT Keys -> Legacy JWT Secret
# Used to sign the login passes our server issues.
SUPABASE_JWT_SECRET=your-jwt-secret

# Same as VITE_SUPABASE_URL, needed by the server functions too.
SUPABASE_URL=https://your-project-ref.supabase.co

# A one-time password you invent yourself. It is required to create the very
# first Super Admin account, then should be deleted from Netlify.
# Example: a long random phrase such as "setup-mygate-2026-x7k2p9".
SETUP_SECRET=invent-a-long-random-phrase-here

# Contact address sent to OpenStreetMap's free geocoding service, as their
# usage policy requires. Your own email is fine.
GEOCODER_CONTACT_EMAIL=you@example.com

# -----------------------------------------------------------------------------
# OPTIONAL - only if free location lookups are not finding enough societies.
#
# Leave this OUT and everything still works, using OpenStreetMap for free.
# Measured on a real Bengaluru society list, OpenStreetMap located roughly
# 1-4 societies in 10 by name. Google locates far more, because it knows
# apartment complexes by name.
#
# Needs: a Google Cloud project with BILLING ENABLED (a card on file), with
# "Places API (New)" and "Geocoding API" turned on. Google gives $200 of free
# credit every month; locating 500 societies costs well under $15, so in
# practice it stays free - but the card is required.
#
# Server-side only. It must NEVER be given a VITE_ prefix.
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
